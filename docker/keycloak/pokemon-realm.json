{
  "realm": "pokemon",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "pokemon-api",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "pokemon-tools",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${POKEMON_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "pokemon-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pokemon-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "pokemon-documentation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${POKEMON_DOCUMENTATION_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:${POKEMON_API_PORT}/signin-oidc"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "pokemon-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pokemon-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "trainer",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Trainer",
      "email": "trainer@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${POKEMON_TRAINER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
